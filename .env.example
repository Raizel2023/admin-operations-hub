# Copy to .env.local for local development; inject the same variables in production.
# Fill in your own PostgreSQL connection string. Never commit .env.local.
DATABASE_URL=

# Required dashboard authentication. Generate a unique random secret of at least 32 characters.
DASHBOARD_AUTH_SECRET=
# Your own deployment origin (HTTPS outside localhost), with no path/query/credentials.
DASHBOARD_APP_BASE_URL=
# Fail closed until dashboard authentication is configured and an authorized account exists.
DASHBOARD_AUTH_ENFORCE=true

# Optional: legacy Google-based EOD editor sign-in. Not needed for local daily-report storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
APP_BASE_URL=

# Optional: authorized legacy EOD Sheet source. Leave blank to keep refresh unavailable.
EOD_GOOGLE_SHEET_ID=
EOD_GOOGLE_SHEET_GID=
# PUBLIC browser-visible source link, embedded at build time. Never put secrets here.
NEXT_PUBLIC_EOD_GOOGLE_SHEET_URL=
# Optional private legacy workbook mapping (comma-separated sheet names / fallback headers).
EOD_LEGACY_STAFF_SHEETS=
EOD_LEGACY_ADMIN_NAMES=
# PUBLIC JSON array of {"key":"<sheet name>","name":"<display label>"}; build-time only.
# Configure only if you intentionally publish those labels to authorized dashboard clients.
NEXT_PUBLIC_EOD_LEGACY_TEAM=

# Optional persistent property-document storage directory; default is storage/property-documents.
PROPERTY_DOCUMENT_STORAGE_DIR=
